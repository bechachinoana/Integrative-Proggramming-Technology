<?php
// api.php
header("Content-Type: application/json; charset=utf-8");
header("Access-Control-Allow-Origin: *");
header("Access-Control-Allow-Methods: GET, POST, OPTIONS");
header("Access-Control-Allow-Headers: Content-Type, Accept");

// Respond to preflight OPTIONS
if ($_SERVER['REQUEST_METHOD'] === 'OPTIONS') {
    http_response_code(200);
    exit();
}

$method = $_SERVER['REQUEST_METHOD'];

if ($method === 'GET') {
    $username = isset($_GET['username']) ? trim($_GET['username']) : null;
    if ($username !== null && $username !== '') {
        echo json_encode([
            "method" => "GET",
            "message" => "Hello, " . htmlspecialchars($username) . " 👋",
            "data" => ["username" => $username]
        ]);
    } else {
        echo json_encode(["error" => "No username provided in GET"]);
    }
    exit();
}

if ($method === 'POST') {
    // Read raw JSON body
    $raw = file_get_contents("php://input");
    $input = json_decode($raw, true);

    if (!is_array($input)) {
        // If invalid JSON
        echo json_encode(["error" => "Invalid JSON input", "raw" => $raw]);
        exit();
    }

    $username = isset($input['username']) ? trim($input['username']) : null;
    if ($username !== null && $username !== '') {
        echo json_encode([
            "method" => "POST",
            "message" => "Hello, " . htmlspecialchars($username) . " 🎉",
            "data" => ["username" => $username]
        ]);
    } else {
        echo json_encode(["error" => "No username provided in POST"]);
    }
    exit();
}

// Fallback
http_response_code(405);
echo json_encode(["error" => "Method not allowed"]);
